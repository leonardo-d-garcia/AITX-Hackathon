{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "src",
    "paths": { "@/*": ["*"] }
  },
  "include": ["src"],
  // Team A's features/cad and Team C's features/simulation + telemetry are excluded from this
  // typecheck: they import @react-three/fiber and @react-three/drei, whose peer range conflicts
  // with React 18 in this install, so the modules are not resolvable here. Their code is on
  // `main` and builds in their own lanes. Re-include once the R3F dependency is agreed.
  "exclude": [
    "src/features/cad",
    "src/features/simulation",
    "src/telemetry.ts",
    "src/App.tsx",
    "src/main.tsx",
    "src/vite-env.d.ts"
  ]
}
