{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dronebench.dev/schemas/parts.schema.json",
  "title": "Parts",
  "description": "Part occurrences with mass and FRD position in metres. Numeric fields are Claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["frame", "occurrences"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "frame": { "type": "string", "const": "FRD" },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/occurrence" }
    }
  },
  "$defs": {
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "type", "mass_kg", "position_frd_m"],
      "properties": {
        "part_id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "motor",
            "prop",
            "esc",
            "battery",
            "servo",
            "fc",
            "rx",
            "gps",
            "spar",
            "wing",
            "fuselage",
            "tail",
            "surface",
            "hinge",
            "linkage",
            "fastener",
            "payload",
            "other"
          ]
        },
        "locked": { "type": "boolean" },
        "mass_kg": { "$ref": "claim.schema.json" },
        "position_frd_m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_m", "y_m", "z_m"],
          "description": "Local position in FRD metres (X forward, Y right, Z down).",
          "properties": {
            "x_m": { "$ref": "claim.schema.json" },
            "y_m": { "$ref": "claim.schema.json" },
            "z_m": { "$ref": "claim.schema.json" }
          }
        },
        "specs": {
          "type": "object",
          "additionalProperties": { "$ref": "claim.schema.json" }
        }
      }
    }
  }
}
